{
  "manifest_version": 3,
  "name": "WSMudEX · 墨境",
  "version": "1.2.1",
  "description": "WSMudEX 墨境版：保留原插件功能，整合三套外观、自定义字体和命令等宽字体。",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*.wsmud2.com/*",
    "https://*.wsmud2.com/*",
    "http://wsmud2.cn/*",
    "https://wsmud2.cn/*",
    "http://*.wsmud2.cn/*",
    "https://*.wsmud2.cn/*",
    "http://wxmud1.com/*",
    "https://wxmud1.com/*",
    "http://*.wxmud1.com/*",
    "https://*.wxmud1.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*.wsmud2.com/*",
        "https://*.wsmud2.com/*",
        "http://wsmud2.cn/*",
        "https://wsmud2.cn/*",
        "http://*.wsmud2.cn/*",
        "https://*.wsmud2.cn/*",
        "http://wxmud1.com/*",
        "https://wxmud1.com/*",
        "http://*.wxmud1.com/*",
        "https://*.wxmud1.com/*"
      ],
      "js": [
        "runtime/page-settings-sync.js",
        "extension/page-load-plan.js",
        "extension/content-loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*.wsmud2.com/*",
        "https://*.wsmud2.com/*",
        "http://wsmud2.cn/*",
        "https://wsmud2.cn/*",
        "http://*.wsmud2.cn/*",
        "https://*.wsmud2.cn/*",
        "http://wxmud1.com/*",
        "https://wxmud1.com/*",
        "http://*.wxmud1.com/*",
        "https://*.wxmud1.com/*"
      ],
      "css": [
        "appearance/theme.css",
        "appearance/wsmudex.css"
      ],
      "js": [
        "appearance/settings.js",
        "appearance/command-font.js",
        "appearance/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "runtime/*.js",
        "vendor/*.js",
        "features/plugin/*.js",
        "features/plugin/plugin-enhancements.css",
        "features/*.js",
        "client/*.js",
        "client/modules/*.js"
      ],
      "matches": [
        "http://*.wsmud2.com/*",
        "https://*.wsmud2.com/*",
        "http://wsmud2.cn/*",
        "https://wsmud2.cn/*",
        "http://*.wsmud2.cn/*",
        "https://*.wsmud2.cn/*",
        "http://wxmud1.com/*",
        "https://wxmud1.com/*",
        "http://*.wxmud1.com/*",
        "https://*.wxmud1.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "WSMudEX · 墨境"
  },
  "icons": {
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "extension/service-worker.js"
  },
  "version_name": "1.2.1-ink.1",
  "minimum_chrome_version": "111"
}
